# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next
/out/

# production
/build
/storybook-static
/coverage

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local isolated runtimes and generated release artifacts
/.agent-data/
/.openlink-runtime/
/.openlink-releases/
/.openlink-qualification/

# next.js build outputs and local tool session data
/.next
/.next.*
/.zcode/
/openlink-paced-*/
/puppeteer_dev_chrome_profile-*/

# nested package installs should never be committed
node_modules/
