# Project-scoped VS Code Web runtime.  The source tree is vendored in
# services/code-server so upgrades can be reviewed against the exact upstream
# revision, while this image installs the matching signed release package to
# avoid compiling VS Code in every developer's Project VM.
FROM debian:13-slim

ARG CODE_SERVER_VERSION=4.131.0

ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/workspace \
    XDG_CONFIG_HOME=/workspace/.openlink/code-server/config \
    XDG_CACHE_HOME=/workspace/.openlink/code-server/cache

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       ca-certificates \
       curl \
       git \
       git-lfs \
       openssh-client \
       procps \
       tini \
  && architecture="$(dpkg --print-architecture)" \
  && curl --fail --location --retry 4 --retry-delay 2 \
       "https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/code-server_${CODE_SERVER_VERSION}_${architecture}.deb" \
       --output /tmp/code-server.deb \
  && apt-get install -y /tmp/code-server.deb \
  && rm -f /tmp/code-server.deb \
  && rm -rf /var/lib/apt/lists/*

EXPOSE 43140

# Authentication is terminated by OpenLink's per-user Agent Host gateway.
# This service is only published on the Project VM's loopback interface and
# must never be linked directly from the browser.
ENTRYPOINT ["tini", "--", "/usr/bin/code-server", "--bind-addr", "0.0.0.0:43140", "--auth", "none", "--disable-telemetry", "--user-data-dir", "/workspace/.openlink/code-server/user-data", "--extensions-dir", "/workspace/.openlink/code-server/extensions", "/workspace"]
