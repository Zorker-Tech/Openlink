# Server-only runtime switch. Local is a self-contained ZOKERBASE instance
# on first start; Cloud uses an explicitly configured hosted control plane.
OPENLINK_RUNTIME_MODE=local
OPENLINK_LOCAL_ZOKERBASE_URL=http://127.0.0.1:54380
OPENLINK_LOCAL_ZOKERBASE_API_PORT=54380
OPENLINK_LOCAL_ZOKERBASE_POSTGRES_PORT=54382
# Local starts with its own Auth issuer, generated automatically on first
# boot. Local does not read Cloud identity, data, or JWT configuration.
# Required only in Cloud mode. They are intentionally blank for a fresh local
# installation because ZOKERBASE generates local API keys automatically.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cross-product browser redirect origin and server-only authenticated grant setup.
NEXT_PUBLIC_ZORKER_APP_URL=http://127.0.0.1:3002
OPENLINK_APP_URL=http://127.0.0.1:3000
ZORKER_APP_URL=http://127.0.0.1:3002
# Set the same 32-byte+ secret in Zorker. Keep it server-only.
CROSS_APP_AUTH_SECRET=

# Bound server-side Supabase auth/database requests so a self-hosted endpoint
# outage cannot leave public or protected Next requests hanging forever.
OPENLINK_SUPABASE_REQUEST_TIMEOUT_MS=5000

# Agent Host BFF and local OpenSandbox control plane (server-only). Browser
# sessions are scoped and routed through this Agent Host; the Browser Host
# service token stays inside the Project VM and is never configured in Next.js.
OPENLINK_AGENT_HOST_URL=http://127.0.0.1:43121
OPENLINK_AGENT_API_TOKEN=replace-with-at-least-32-random-characters
# Maximum number of live Agent sandboxes per Agent Host process. A Project VM
# still owns the actual workloads; this cap prevents an unbounded number of
# Cloud sessions from exhausting the VM.
OPENLINK_AGENT_MAX_SESSIONS=32
# Public origin used by the browser for session-scoped preview/WebSocket
# gateway URLs. In a remote deployment this must be the HTTPS reverse-proxy
# origin that forwards /v1/browser/gateway/* to Agent Host.
OPENLINK_BROWSER_GATEWAY_PUBLIC_URL=http://127.0.0.1:43121
OPENLINK_BROWSER_GATEWAY_ALLOWED_ORIGINS=http://localhost:3000
OPENLINK_BROWSER_GATEWAY_UPSTREAM_ORIGIN=http://localhost:3000
# Desktop-only Agent Host. It is not used by the web application.
OPENLINK_DESKTOP_AGENT_HOST_URL=http://127.0.0.1:43123
OPENLINK_DESKTOP_AGENT_API_TOKEN=replace-with-at-least-32-random-characters
OPEN_SANDBOX_DOMAIN=127.0.0.1:43122
OPEN_SANDBOX_API_KEY=replace-with-at-least-32-random-characters
OPENLINK_AGENT_WORKER_IMAGE=openlink/agent-worker:dev
OPENLINK_AGENT_RPC_WORKER_IMAGE=openlink/agent-rpc-worker:dev
OPENLINK_PROJECT_VM_STATE_ROOT=.project-vms
# Image production is a separate release step. Leave unset for normal service
# startup; the supervisor consumes the already-published local VM disk.
OPENLINK_BUILD_ARTIFACTS=0
OPENLINK_PROJECT_VM_BOOTSTRAP=1
OPENLINK_PROJECT_VM_CPUS=4
OPENLINK_PROJECT_VM_MEMORY_MB=8192
OPENLINK_PROJECT_VM_DISK_GB=64
# Project runtime service ports prefer 51000/52000/... and scan the next 1000
# base-port slots when a host process or another Project occupies a candidate.
OPENLINK_PROJECT_RUNTIME_PORT_BASE=51000
OPENLINK_PROJECT_RUNTIME_PORT_RANGE_SIZE=1000
# Web Project VMs must use rootful Podman inside the VM so OpenSandbox can
# enforce the per-session egress/Credential Vault sidecar. Set to 0 only with
# the explicit unsafe-provider-credentials development escape hatch below.
OPENLINK_PROJECT_VM_ROOTFUL=1
OPENLINK_ALLOW_UNSAFE_ROOTLESS_PROVIDER_CREDENTIALS=0

# Optional provider routing; real keys remain host-side and are injected by the
# OpenSandbox Credential Vault or sandbox-runtime credential masker.
OPENLINK_AGENT_MODEL=
GEMINI_API_KEY=
GOOGLE_GEMINI_BASE_URL=

# Remote SSH transport requires a pre-populated known_hosts file.
OPENLINK_SSH_KNOWN_HOSTS_FILE=
OPENLINK_SSH_IDENTITY_FILE=
OPENLINK_SSH_TARGET_ID=
OPENLINK_SSH_HOST=
OPENLINK_SSH_USER=
OPENLINK_SSH_PORT=22
OPENLINK_REMOTE_ROOT=
OPENLINK_REMOTE_WORKSPACE_ROOT=
OPENLINK_REMOTE_RELEASE_DIR=
OPENLINK_REMOTE_AGENT_API_TOKEN=replace-with-at-least-32-random-characters
OPENLINK_REMOTE_AGENT_PORT=43124
# Optional proxies reachable from the SSH target. SSH does not forward the
# local shell's HTTP_PROXY automatically, so set these when that server needs a
# proxy to download the Ubuntu base image or bootstrap packages.
OPENLINK_REMOTE_HTTP_PROXY=
OPENLINK_REMOTE_HTTPS_PROXY=

# Local project preview attached to native iframe mode
OPENLINK_PREVIEW_TARGET_URL=http://127.0.0.1:3001
OPENLINK_PREVIEW_PATH_MODE=strip-session-prefix

# Chromium network policy (empty allowlist permits public domains)
OPENLINK_BROWSER_ALLOWED_DOMAINS=
OPENLINK_BROWSER_DENIED_DOMAINS=
OPENLINK_BROWSER_ALLOW_LOOPBACK=false
OPENLINK_BROWSER_ALLOW_PRIVATE_NETWORKS=false
# Server-only 32-byte key (base64 or 64 hex chars) used for AES-256-GCM provider credentials.
# Development persists this key in .openlink-runtime/provider-secret.key when omitted;
# production must set it explicitly and keep it stable across deployments.
OPENLINK_PROVIDER_SECRET_KEY=
# Keep disabled in Web deployments. Enable only for a trusted local provider endpoint.
OPENLINK_ALLOW_INSECURE_PROVIDER_ENDPOINTS=0
