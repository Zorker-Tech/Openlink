[Unit]
Description=OpenLink self-hosted production runtime
Documentation=https://git.haokir/hydite/openlink/openlink
Wants=network-online.target
After=network-online.target openlink-container-broker.service openlink-project-container-broker.service
Requires=openlink-container-broker.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
User=root
Group=root
EnvironmentFile=/etc/openlink/openlink.env
ExecStart=/opt/openlink/current/bin/openlinkctl run --config /etc/openlink/openlink.env
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
KillSignal=SIGTERM
TimeoutStartSec=600
TimeoutStopSec=180
Restart=on-failure
RestartSec=5
UMask=0077
LimitNOFILE=1048576
TasksMax=4096
MemoryMax=16G
MemorySwapMax=2G
CPUQuota=800%
WorkingDirectory=/var/lib/openlink
RuntimeDirectory=openlink
RuntimeDirectoryMode=0700
StateDirectory=openlink
StateDirectoryMode=0711
LogsDirectory=openlink
LogsDirectoryMode=0700
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
AmbientCapabilities=CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_NET_BIND_SERVICE
PrivateDevices=false
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
KeyringMode=private
RemoveIPC=true
ReadWritePaths=/var/lib/openlink /var/log/openlink /var/backups/openlink /run/openlink

[Install]
WantedBy=multi-user.target
