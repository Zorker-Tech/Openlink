# Non-secret public deployment identity.
OPENLINK_RUNTIME_MODE=local
OPENLINK_APP_URL=https://openlink.example.com
OPENLINK_BROWSER_GATEWAY_PUBLIC_URL=https://openlink.example.com
OPENLINK_BROWSER_GATEWAY_ALLOWED_ORIGINS=https://openlink.example.com
OPENLINK_DOMAIN=openlink.example.com

# Runtime paths are outside the immutable release directory.
OPENLINK_STATE_ROOT=/var/lib/openlink
OPENLINK_LOG_ROOT=/var/log/openlink
OPENLINK_BACKUP_ROOT=/var/backups/openlink

# Secrets are read from protected files owned by the OpenLink service account.
OPENLINK_SECRETS_FILE=/etc/openlink/secrets.env
OPENLINK_RELEASE_TRUST_FILE=/etc/openlink/release-keys.json

# Resource policy must be sized for this installation before production use.
OPENLINK_DEPLOYMENT_PROFILE=standard
OPENLINK_DEPLOYMENT_PROFILE_REVISION=standard/v1
OPENLINK_PROJECT_RUNTIME=vm
OPENLINK_PROJECT_ISOLATION=vm
OPENLINK_KNOWLEDGE_ENABLED=1
OPENLINK_ZERO_ENABLED=1
OPENLINK_AGENT_MAX_SESSIONS=32
OPENLINK_MINIMUM_LOGICAL_CPUS=8
OPENLINK_PROJECT_VM_CPUS=4
OPENLINK_PROJECT_VM_MEMORY_MB=8192
OPENLINK_PROJECT_VM_DISK_GB=64
OPENLINK_MINIMUM_MEMORY_BYTES=34359738368
OPENLINK_MINIMUM_FREE_BYTES=214748364800
